    <worksheet name='08 Race Bars'>
      <table>
        <view>
          <datasources>
            <datasource caption='survey_combined' name='federated.1izsxwe02vbz9o0zzdbd8029f9cw' />
          </datasources>
          <datasource-dependencies datasource='federated.1izsxwe02vbz9o0zzdbd8029f9cw'>
            <column caption='Race is White' datatype='real' default-format='p0%' name='[Gender is Female (copy)_963770383757877257]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([race]==&quot;WHITE&quot;,[weight],0))/&#13;&#10;SUM([weight])' />
            </column>
            <column caption='Is Hispanic/Latino' datatype='real' default-format='p0%' name='[Race is Asian (copy)_963770383760818192]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([hispanic]==&quot;HISPANIC/LATINO OR OF SPANISH ORIGIN&quot;,[weight],0))/&#13;&#10;SUM([weight])' />
            </column>
            <column caption='Race is Asian' datatype='real' default-format='p0%' name='[Race is Black (copy)_963770383760277517]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([race]==&quot;ASIAN&quot;,[weight],0))/&#13;&#10;SUM([weight])' />
            </column>
            <column caption='Race is Black' datatype='real' default-format='p0%' name='[Race is White (copy)_963770383759831051]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([race]==&quot;BLACK&quot;,[weight],0))/&#13;&#10;SUM([weight])' />
