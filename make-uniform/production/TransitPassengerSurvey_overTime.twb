        <calculation class='tableau' formula='SUM(IIF([hispanic]==&quot;HISPANIC/LATINO OR OF SPANISH ORIGIN&quot;,[weight],0))/&#13;&#10;SUM([weight])' />
      </column>
      <column caption='Race is Asian' datatype='real' default-format='p0%' name='[Race is Black (copy)_963770383760277517]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([race]==&quot;ASIAN&quot;,[weight],0))/&#13;&#10;SUM([weight])' />
      </column>
